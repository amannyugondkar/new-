# Copy this file to .env. Do not commit .env.
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./data/finsight.db
CORS_ORIGINS=http://localhost:3000
# Optional grounded explanation provider. Leave blank for local verified answers.
NVIDIA_NIM_API_KEY=paste-your-nvidia-nim-key-here
# Use a model enabled on your NVIDIA account. List options with GET https://integrate.api.nvidia.com/v1/models
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b